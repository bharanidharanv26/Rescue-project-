# Required for live microphone transcription and semantic emergency extraction.
# Never put this key in a VITE_ variable; it must stay on the server.
MISTRAL_API_KEY=
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-transcribe-realtime-3
MISTRAL_EXTRACTION_MODEL=mistral-small-latest

# Shared server and persisted resource/mission state.
API_PORT=3001
SIMULATION_DATA_FILE=.data/aegis-network.json
